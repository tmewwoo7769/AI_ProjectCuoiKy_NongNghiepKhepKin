# Copy file nay thanh ".env" roi dien thong tin thuc te vao, dung xoa file .env.example goc

# ---------- MQTT ----------
# Lay tu HiveMQ Cloud sau khi tao cluster + access credentials.
# Dang cloud (TLS):  mqtts://<host-cluster>.s1.eu.hivemq.cloud:8883
# Dang test cuc bo:  mqtt://localhost:1883   (chay kem "npm run broker")
MQTT_URL=mqtts://<host-cluster-cua-ban>.hivemq.cloud:8883
MQTT_USER=<username-da-tao>
MQTT_PASS=<password-da-tao>

# Prefix topic. Backend se subscribe "<prefix>/+/data" va publish lenh len "<prefix>/<node_id>/cmd"
MQTT_TOPIC_PREFIX=agri

# ---------- MongoDB ----------
# Local (MongoDB Community tren may):
MONGO_URL=mongodb://127.0.0.1:27017/agri_ecosystem
# Hoac MongoDB Atlas:
# MONGO_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/agri_ecosystem?retryWrites=true&w=majority

# ---------- HTTP ----------
PORT=4000
# Origin cua frontend duoc phep goi API. Nhieu origin ngan cach bang dau phay.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# ---------- Dinh danh node ----------
NODE_FARM_ID=node1_vuon
NODE_COLD_ID=node2_vanchuyen

# So giay khong nhan duoc ban tin thi coi node la Offline
NODE_OFFLINE_AFTER_SEC=90

# So ngay giu ban ghi cam bien, qua han MongoDB tu xoa.
# Atlas goi mien phi co 512 MB. Do thuc te: ~650 byte moi ban ghi (ke ca index),
# hai node gui 5s/10s mot lan la ~16.8 MB moi ngay -> 21 ngay on dinh o khoang 350 MB.
# Dat 0 de giu lai toan bo du lieu (nho tu theo doi dung luong).
READING_TTL_DAYS=21

# ---------- Nguong canh bao ----------
# Vuon (Node 1) - dung de hien thi va doi chieu voi quyet dinh TinyML
SOIL_MOISTURE_THRESHOLD=35
AIR_TEMP_THRESHOLD=38
AIR_HUMID_THRESHOLD=90
LIGHT_THRESHOLD=5000

# Chuoi lanh (Node 2) - nguong rung lac tinh 1 lan va dap (g)
VIBRATION_IMPACT_G=0.5
