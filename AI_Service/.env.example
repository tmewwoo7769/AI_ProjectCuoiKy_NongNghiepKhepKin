# Sao chép tệp này thành .env và chỉ điền khóa ở máy chạy backend.
# Không đưa tệp .env lên Git hoặc đặt khóa API trong mã frontend.

# Ưu tiên Gemini, sau đó OpenAI. Nếu để trống, trợ lý dùng phân tích dự phòng.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_SMALL_MODEL=gemini-3.1-flash-lite
USE_LLM_FILTER=0

LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Có thể điền khi cần gửi cảnh báo Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backend Node - noi cung cap du lieu cam bien that (MongoDB Atlas)
NODE_API_URL=http://127.0.0.1:4000
NODE_FARM_ID=node1_vuon

# Nguong canh bao, giu trung voi BE_Giamsat/.env
SOIL_MOISTURE_THRESHOLD=35
AIR_TEMP_THRESHOLD=38
AIR_HUMID_THRESHOLD=90

# Mui gio dia phuong. Backend Node luu UTC, dich vu AI doi sang gio nay
# truoc khi ve bieu do va tra loi.
TZ_OFFSET_HOURS=7
